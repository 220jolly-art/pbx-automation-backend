# PBX Automation Backend — env vars
# Copy to .env and fill in. Never commit a real .env.

# Port the API listens on (default 3000)
PORT=3000

# Admin token for the admin panel and admin API routes.
# Send it as header: X-Admin-Token: <token>
# Generate a strong random value, e.g. `openssl rand -hex 32`
ADMIN_TOKEN=change-me-to-a-long-random-token

# SQLite database file (local dev default). Relative paths resolve
# against the backend/ directory.
DATABASE_PATH=./data.db

# --- Hosting (Postgres) switch ---
# On Render free tier, set DATABASE_URL to the free Postgres connection
# string instead of DATABASE_PATH. The db layer (db.js) detects
# DATABASE_URL and notes the switch; the current implementation uses
# SQLite locally and documents the Postgres migration path in db.js.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Optional: captcha solver API key placeholder (stored in the config
# table via the admin panel instead of env; kept here only as a note).
# CAPTCHA_API_KEY=
